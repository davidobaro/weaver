# Configure locally; never commit a real key.
NEBIUS_API_KEY=
# Change these if your Token Factory account uses another endpoint or model.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional: use another local database path.
# WEAVER_DB_PATH=/absolute/path/to/weaver.sqlite3
