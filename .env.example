# Configure locally; never commit a real key.
NEBIUS_API_KEY=
# Change these if your Token Factory account uses another endpoint or model.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional: use another local database path.
# WEAVER_DB_PATH=/absolute/path/to/weaver.sqlite3
# Optional: temporary demo mode (local mode is the default).
# WEAVER_MODE=demo
# WEAVER_DEMO_IDLE_SECONDS=3600
# WEAVER_DEMO_LIFETIME_SECONDS=86400
# WEAVER_DEMO_MAX_SESSIONS=100
# WEAVER_DEMO_MAX_ENTRIES=20
# WEAVER_DEMO_MAX_ORGANIZATIONS=10
# WEAVER_DEMO_WORKERS=2
# WEAVER_DEMO_QUEUE_SIZE=4
# Per-process day allowance; resets on process restart, not a billing guarantee.
# WEAVER_DEMO_PROVIDER_CALLS=500
# WEAVER_DEMO_SESSIONS_PER_HOUR=10
# WEAVER_DEMO_ORGANIZATIONS_PER_HOUR=30
# Custom hosted domains, comma-separated; Render's own hostname is automatic.
# WEAVER_ALLOWED_HOSTS=weaver.example.com
# WEAVER_ALLOWED_ORIGINS=https://weaver.example.com
